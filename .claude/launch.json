{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "playground",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "playground-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run dev -- --port ${PORT:-5174}"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "la28-app-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ~/Developer/LA28/la28-app && CI=1 npx expo start --web --port 8081"
      ],
      "port": 8081
    }
  ]
}
